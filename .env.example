# Copy to .env for local development. Never commit .env.
# On Vercel set these in Project → Settings → Environment Variables.

APP_NAME="Ayaka Sync API"
# development | production  (production enables Secure cookies and strict checks)
APP_ENV=development
# Public URL, no trailing slash. LOCAL DEV ONLY: http://localhost:8000
# On Vercel: leave it EMPTY to auto-detect the deployment/custom domain, or set your real
# domain (e.g. https://api.ayaka.dev). A localhost value is ignored on Vercel.
APP_BASE_URL=http://localhost:8000

# Neon pooled connection string (host contains "-pooler"), keep sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=30
API_KEY_PEPPER=change-me-to-a-different-long-random-string

# Comma-separated list of allowed browser origins for cross-origin API calls
CORS_ORIGINS=http://localhost:8000
# Default requests per minute per API key
RATE_LIMIT_DEFAULT=60
LOG_LEVEL=INFO
